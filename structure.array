#include <stdio.h>
struct Student {
int roll;
char name[20];
float m1,m2,m3,total,per;
}
int main() {
struct Student s[10];
int n, i ;
printf("Enter number of students: ");
scanf("%d" , &n);
for(i = 0; i < n; i++) {
printf("\nRoll No: ");
scanf("%d", &s[i].roll);
printf("Name: ");
scanf("%s", s[i].name);
printf("Enter 3 subject marks: ");
scanf("%f %f %f", &s[i].m1, &s[i].m2, &s[i].m3);
s[i].total = s[i].m1 + s[i].m2 + s[i].m3;
s[i].per = s[i].total /3;
}
printf("\n----- Result-----\n");
for(i = 0; i < n; i++){
printf("\n%d %s %.2f%% %s",s[i].roll, s[i].name, s[i].per , (s[i].per >=40) "PASS" : "fAIL");
}
return 0;
}
