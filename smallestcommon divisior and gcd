#include <stdio.h>
int main() {
int a, b, i;
printf("Enter two numbers: ");
scanf("%d %d", &a, &b);
// Smallest Common Divisor
for(i = 2; i <= a && i <= b; i++) {
if(a % i == 0 && b % i == 0) {
printf("Smallest Common Divisor = %d\n" , i);
break;
}
}
// GCD
int gcd = 1;
for(i = 1; i <= a && i <= b; i++) {
if(a % i == 0 && b % i == 0) {
gcd = i;
}
}
printf("GCD = %d" , gcd);
return 0;
}
