#include <stdio.h>
#include <math.h>
int main()
{
int n, i , fact = 1, isPrime = 1;
printf("Enter a number: ");
scanf("%d" , &n);
// Square
printf("\nSquare of %d = %d" , n , n * n);
// Cube
printf("\nCube of %d = %d" , n, n*n*n);
// Square Root
printf("\nSquare root of %d = %.2f" , n,sqrt(n));
//Prime Check
if (n <= 1 )
isPrime = 0;
else
{
for(i = 2; i <= n/2; i++)
{
if (n % i == 0)
{
isPrime = 0;
break;
}
}
}
if (isPrime)
printf("\n%d is a Prime number", n );
else
printf("\n%d is NOT a prime number" , n);
//Factorial
if(n < 0)
printf("\nFactorial not defined for negative numbers");
else
{
for(i = 1; i <= n; i++)
fact = fact * i;
printf("\nFactorial of %d = %d" , n , fact);
}
//Prime Number
printf("\nPrime factorsof %d are: ", n);
for(i = 2; i <= n; i++)
{
while(n % i == 0)
{
printf("%d" , i);
n = n / i;
}
}
return 0;
}
