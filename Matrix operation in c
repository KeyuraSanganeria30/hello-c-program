#include <stdio.h>
int main()
{
int a[1o][10], b[10][10], i, j, r, c;
printf("Enter rows and columns: ");
scanf("%d%d", &r, &c);
printf("Enter first matrix:\n");
for(i=0;i<r;i++)
for(j=0;j<c;j++)
scanf("%d" ,&a[i][j]);
printf("Enter Second matrix:\n");
for(i=0;i<r;i++)
for(j=0;j<c;j++)
scanf("%d" ,&b[i][j]);
//Addition
printf("\nAddition:\n");
for(i=0;i<r;i++){
for(j=0;j<c,j++)
printf("%d" , a[i][j]+b[i][j]);
printf("\n");
}
//Saddle point(only first matrix)
printf("\nSaddle Point:|n");
for(i=0;i<r;i++){
int min=a[i][0], col=0, flag=1;
for(j=1;j<c;j++)
if(a[i][j]<min){min=a[i][j]; col=j;}
for(j=0;j<r;j++)
if(a[j][col]>min) flag=0;
if(flag) printf("%d", min);
}
//Inverse (2*2 only)
if(r==2 && c ==2) {
int det = a[0][0]*a[1][1] - a[0][1]*a[1][0];
if(det!=0){
printf("\n\nInverse:\n");
printf("%.2f %.2f\n%.2f %.2f\n",
a[1][1]/(float)det, a[0][1]/(float)det,
a[1][0]/(float)det , a[0][0]/(float)det;
} else
printf("\nInverse not possible" );
}
//Magic Square Check(first matrix)
if(r==c){
int sum=0, flag=1 ;
for(j=0;j<c;j++) sum+=a[0][j];
for(i=1;i<r;i++){
int s=0;
for(j=0;j<c;j++) s+=a[i][j];
if(s !=sum) flag = 0;
}
if(flag) printf("\nMagic Square");
else printf("\nNot Magic Square");
}
return 0;
}
